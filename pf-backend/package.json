{
  "name": "pratishtha-finance-backend",
  "version": "1.0.0",
  "description": "Pratishtha Finance \u2014 backend + web app",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node make-seed.js public/index.html",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"test/unit/*.test.js\"",
    "test:integration": "node --disable-warning=ExperimentalWarning --test \"test/integration/*.test.js\"",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/unit/*.test.js\" \"test/integration/*.test.js\" \"test/security/*.test.js\"",
    "test:security": "node --disable-warning=ExperimentalWarning --test \"test/security/*.test.js\""
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.5"
  }
}