# Copy to .env (or set in your host's dashboard). REQUIRED for live use:
NODE_ENV=production
PORT=5000
ADMIN_MOBILE=7233023547
ADMIN_NAME=CEO Pratishtha
# 12+ characters, letters + digits, not a dictionary word. The server REFUSES to start in production otherwise.
ADMIN_PASSWORD=
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Where the database file lives. On a host with a persistent disk, point this at the disk (e.g. /data/pratishtha.db)
DB_PATH=./data/pratishtha.db
# false = start empty (live). true = load demo customers/loans for a trial
SEED_DEMO=false
# Initial password given to newly created staff (they must change it at first login). REQUIRED in production, must not be the old default.
DEFAULT_STAFF_PASSWORD=ChangeThis-Staff-Initial-Pass-1

# Domain: pratishtha.pro (the app and API are served from the same domain, so no CORS is needed)
FACE_RP_ID=pratishtha.pro
FACE_ORIGIN=https://pratishtha.pro
